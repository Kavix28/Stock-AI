# Data directories (keep manifests and sample/metadata; ignore large bulk dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/market/*.parquet

# Model binary weights & embeddings caches (reproducible via scripts)
*.pt
*.npz
data/processed/embeddings/*.npz
models/**/*.pt
