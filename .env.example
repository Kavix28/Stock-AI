# Stock-AI Environment Configuration Example
# Copy this file to .env and adjust as necessary for your local setup.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data Directories
DATA_RAW_DIR=data/raw/market
DATA_PROCESSED_DIR=data/processed
RESULTS_DIR=results/latest

# Model Configuration
DEFAULT_RANDOM_SEED=42
LOOKBACK_WINDOW=20
DECISION_THRESHOLD=0.50
